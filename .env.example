# API backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# App
NEXT_PUBLIC_APP_NAME=Hub Client Portal
NEXT_PUBLIC_SITE_URL=https://digisider.com
NEXT_PUBLIC_REFERRAL_BASE_URL=https://digisider.com/register?ref=

# Subdominio del tenant plataforma (usado para cargar branding en landing page pública)
NEXT_PUBLIC_TENANT_SUBDOMAIN=system

# Dokploy (solo producción) — dominio público del Hub (dominio raíz, ya no subdominio)
HUB_DOMAIN=digisider.com

# reCAPTCHA v3 (obtener en https://www.google.com/recaptcha/admin — tipo: reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Yape — datos para mostrar al usuario en el paso de pago manual
NEXT_PUBLIC_YAPE_PHONE=999 000 000
NEXT_PUBLIC_YAPE_HOLDER=Mi Empresa SAC
